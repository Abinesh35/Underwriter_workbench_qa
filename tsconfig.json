{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "components/**/*.ts",
    "fixtures/**/*.ts",
    "locators/**/*.ts",
    "helpers/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "data/**/*.ts",
    "models/**/*.ts",
    "interfaces/**/*.ts",
    "ai/**/*.ts",
    "knowledge-graph/**/*.ts",
    "playwright.config.ts"
  ]
}
